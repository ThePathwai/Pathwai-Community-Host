# ---------------------------------------------------------------------------------------------
# Local development: copy to backend/.env.  Production (Railway): set these as service variables
# instead -- see DEPLOY.md for the exact list. A real deployment needs NO demo settings.
# ---------------------------------------------------------------------------------------------

# --- database
MONGO_URL="mongodb://localhost:27017"
DB_NAME="pathwai"
USE_MOCK_DB="false"          # "true" = in-memory mongomock (no MongoDB needed) AND demo mode: fake communities, demo logins
# DEMO_MODE=""               # leave unset. "true" forces demo mode on a real database (a separate public demo site ONLY); "false" forces it off

# --- secrets (REQUIRED in production; the server refuses to start with weak/missing ones)
JWT_SECRET="generate-a-long-random-string"       # openssl rand -hex 32
INTEGRATIONS_SECRET="change-me"                  # a DIFFERENT random string; encrypts saved Stripe/Twilio/SendGrid/Airtable/Luma keys. Never change it later.

# --- web
CORS_ORIGINS="http://localhost:3000"             # production: your site's https origin (a wildcard is refused)
FRONTEND_URL="http://localhost:3000"             # used in password-reset emails and as Stripe's return address
PUBLIC_API_URL=""                                # production: same as FRONTEND_URL when one service serves both (shows webhook URLs, verifies Twilio)
PLATFORM_ADMIN_EMAILS=""                         # comma-separated; can enter/edit every community. Production: your own email
UPLOADS_DIR=""                                   # production: a path on a Railway Volume, e.g. /data/uploads
COOKIE_SECURE="false"                            # leave UNSET in production (defaults to true). "false" only for plain-http local dev
# COOKIE_SAMESITE="lax"                          # leave unset. Only change for a two-domain setup (see DEPLOY.md section 11)

# --- email (platform emails: password reset)
SENDGRID_API_KEY=""                              # without it reset links are only logged
MAIL_FROM_EMAIL="no-reply@pathwai.app"           # must be a sender/domain verified in SendGrid
MAIL_FROM_NAME="Pathwai"
RESET_TOKEN_MIN="30"

# --- social sign-in (optional; blank hides the button)
GOOGLE_CLIENT_ID=""                              # OAuth Web client ID (ID-token flow: no secret). Add every origin you sign in from as an Authorized JavaScript origin.
APPLE_CLIENT_ID=""

# --- sessions
ACCESS_TOKEN_MIN="60"
REFRESH_TOKEN_DAYS="7"

# --- optional
ENABLE_AI_CHAT="false"                           # "true" turns on /ask -- also needs OPENAI_API_KEY (or EMERGENT_LLM_KEY)
EMERGENT_LLM_KEY=""

# --- demo / dev only (ignored in production)
DEMO_PASSWORD="Demo123!"
DEMO_PUBLIC_SEED="true"
