MONGO_URL="mongodb://localhost:27017"
DB_NAME="pathwai"
CORS_ORIGINS="http://localhost:3000"
ENABLE_AI_CHAT="false"        # "true" turns on the /ask assistant — also needs OPENAI_API_KEY (or EMERGENT_LLM_KEY) set below
EMERGENT_LLM_KEY=""          # or set OPENAI_API_KEY for the local stand-in
JWT_SECRET="generate-a-long-random-string"
ACCESS_TOKEN_MIN="60"
REFRESH_TOKEN_DAYS="7"
DEMO_PASSWORD="Demo123!"
COOKIE_SECURE="true"         # "false" for plain-http local dev
COOKIE_SAMESITE="lax"
DEMO_PUBLIC_SEED="true"
USE_MOCK_DB="false"          # "true" = in-memory mongomock, no MongoDB needed
INTEGRATIONS_SECRET=change-me   # encrypts stored Airtable/Luma/Stripe credentials
FRONTEND_URL="http://localhost:3000"   # used to build links in outgoing email (password reset, etc)
RESET_TOKEN_MIN="30"          # minutes a password-reset link stays valid
SENDGRID_API_KEY=""            # platform-level sender for password resets — without it, reset links are logged, not emailed
MAIL_FROM_EMAIL="no-reply@pathwai.app"
MAIL_FROM_NAME="Pathwai"
