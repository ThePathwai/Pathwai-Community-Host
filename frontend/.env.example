REACT_APP_BACKEND_URL=
# leave empty in dev: CRA proxies /api to http://localhost:8001
REACT_APP_AI_CHAT_ENABLED=false   # "true" shows the /ask assistant — only if ENABLE_AI_CHAT is also true on the backend

# PostHog browser analytics (public project token and ingestion host)
REACT_APP_POSTHOG_KEY=phc_your_project_token
REACT_APP_POSTHOG_HOST=https://your-posthog-host
